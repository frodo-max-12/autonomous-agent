# ai-agent.env  —  systemd EnvironmentFile (SECRETS)  —  chmod 600 after editing
# Copy to /home/agent/ai-agent/deploy/ai-agent.env and fill in the real token.
#
# Get the token on ANY machine that has a browser:
#     claude setup-token
# It prints a ~1-year OAuth token bound to your Claude Max plan. Paste it here.
# NOTE: this token does NOT auto-refresh. Set a calendar reminder ~11 months out
# to run `claude setup-token` again and replace the value below, then restart the service.

CLAUDE_CODE_OAUTH_TOKEN=paste-the-setup-token-here

# (Everything else the agent needs is already in the app's own .env file.)
